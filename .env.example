# ==============================================================================
# AUTO-blogger Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# WordPress Configuration
# ------------------------------------------------------------------------------

# Your WordPress site URL (without trailing slash)
WORDPRESS_URL=https://your-site.com

# WordPress username (admin or editor role required)
WORDPRESS_USERNAME=your_username

# WordPress Application Password (generate in WordPress Admin > Users > Profile)
# Note: This is NOT your regular WordPress password
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------------------------------------------

# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (optional, defaults to gemini-pro)
# Options: gemini-pro, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-pro

# ------------------------------------------------------------------------------
# OpenAI Configuration (for DALL-E image generation)
# ------------------------------------------------------------------------------

# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Organization ID (optional)
OPENAI_ORG_ID=

# DALL-E model to use
# Options: dall-e-2, dall-e-3
OPENAI_DALLE_MODEL=dall-e-3

# Default image size
# DALL-E 2: 256x256, 512x512, 1024x1024
# DALL-E 3: 1024x1024, 1792x1024, 1024x1792
OPENAI_IMAGE_SIZE=1024x1024

# Image style (dall-e-3 only)
# Options: vivid, natural
OPENAI_IMAGE_STYLE=vivid

# ------------------------------------------------------------------------------
# Getty Images Configuration (optional)
# ------------------------------------------------------------------------------

# Get credentials from: https://developer.gettyimages.com/
GETTY_API_KEY=your_getty_api_key_here
GETTY_API_SECRET=your_getty_api_secret_here

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------

# Debug mode (true/false)
AUTO_BLOGGER_DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Browser for Selenium automation
# Options: chrome, firefox, edge (chrome recommended)
BROWSER=chrome

# Headless mode for browser (true/false)
HEADLESS=true

# Default timeout for web operations (seconds)
TIMEOUT=30

# Maximum retries for failed operations
MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Content Settings
# ------------------------------------------------------------------------------

# Default post status when publishing
# Options: draft, pending, publish
DEFAULT_POST_STATUS=draft

# Default author ID (WordPress user ID)
DEFAULT_AUTHOR_ID=1

# Enable SEO optimization
ENABLE_SEO=true

# Enable internal link injection
ENABLE_INTERNAL_LINKS=true

# Enable external link injection
ENABLE_EXTERNAL_LINKS=true

# Enforce British English spelling
USE_BRITISH_ENGLISH=true

# ------------------------------------------------------------------------------
# Source Configuration (default values)
# ------------------------------------------------------------------------------

# Default source URL to scrape articles from
# SOURCE_URL=https://example.com/news

# Default CSS selectors (can be configured per-domain)
# ARTICLE_LINK_SELECTOR=article a.title
# ARTICLE_TITLE_SELECTOR=h1.article-title
# ARTICLE_CONTENT_SELECTOR=div.article-content

# ------------------------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------------------------

# Enable credential encryption (recommended for production)
ENCRYPT_CREDENTIALS=false

# Path to encryption key file
# ENCRYPTION_KEY_FILE=.encryption_key

# ------------------------------------------------------------------------------
# Proxy Configuration (optional)
# ------------------------------------------------------------------------------

# HTTP Proxy
# HTTP_PROXY=http://proxy.example.com:8080

# HTTPS Proxy
# HTTPS_PROXY=https://proxy.example.com:8080

# Bypass proxy for these hosts
# NO_PROXY=localhost,127.0.0.1
